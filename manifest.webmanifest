{
  "name": "Graphite",
  "short_name": "Graphite",
  "description": "Daily drawing tracker with streaks, goals and charts to keep you motivated.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0f15",
  "theme_color": "#11131a",
